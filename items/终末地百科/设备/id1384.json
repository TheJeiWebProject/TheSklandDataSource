            ],
            "blockMap": {
              "JuQ4LI8vMpWT": {
                "id": "JuQ4LI8vMpWT",
                "parentId": "document-id",
                "align": "left",
                "kind": "text",
                "text": {
                  "inlineElements": [
                    {
                      "color": "light_text_tertiary",
                      "kind": "text",
                      "text": {
                        "text": "“这就是你差点炸穿帝江号的理由？”"
                      }
                    }
                  ],
                  "kind": "body"
                }
              },
              "N3zrMl": {
                "id": "N3zrMl",
                "parentId": "document-id",
                "align": "left",
                "kind": "text",
                "text": {
                  "inlineElements": [
                    {
                      "color": "light_text_tertiary",
                      "kind": "text",
                      "text": {
                        "text": "“你知道的，对吧，我的朋友，我们的炼金术有着多么辉煌的历史，看看外面的太空……我们的征服与成就怎么能止步于此呢？我需要一个好环境，一个优秀、稳定的源石环境。”"
                      }
                    }
                  ],
                  "kind": "body"
                }
              },
              "zZ46FZ": {
                "id": "zZ46FZ",
                "parentId": "document-id",
                "align": "left",
                "kind": "text",
                "text": {
                  "inlineElements": [
                    {
                      "bold": true,
                      "color": "light_text_primary",
                      "kind": "text",
                      "text": {
                        "text": "用于将溶液提纯至更高纯度溶液的设备。"
                      }
                    }
                  ],
                  "kind": "body"
                }
              }
            },
