              "blockMap": {
                "6WoCSphDVTK7": {
                  "id": "6WoCSphDVTK7",
                  "parentId": "document-id",
                  "kind": "horizontalLine",
                  "horizontalLine": {
                    "kind": "2"
                  }
                },
                "6n7Q137ktSiw": {
                  "id": "6n7Q137ktSiw",
                  "parentId": "document-id",
                  "align": "left",
                  "kind": "text",
                  "text": {
                    "inlineElements": [
                      {
                        "kind": "text",
                        "text": {
                          "text": "来自莱万汀的祝福"
                        }
                      }
                    ],
                    "kind": "heading3"
                  }
                },
                "GQWOzRZcgWvd": {
                  "id": "GQWOzRZcgWvd",
                  "parentId": "document-id",
                  "align": "left",
                  "kind": "text",
                  "text": {
                    "inlineElements": [
                      {
                        "kind": "text",
                        "text": {
                          "text": "东西收到了，对吧? "
                        }
                      }
                    ],
                    "kind": "body"
                  }
                },
                "WRY29hBTlwhH": {
                  "id": "WRY29hBTlwhH",
                  "parentId": "document-id",
                  "align": "left",
                  "kind": "text",
                  "text": {
                    "inlineElements": [
                      {
                        "color": "light_rank_yellow",
                        "kind": "text",
                        "text": {
                          "text": "莱万汀"
                        }
                      }
                    ],
                    "kind": "body"
                  }
                },
                "Wm5IlTbgsbqg": {
                  "id": "Wm5IlTbgsbqg",
                  "parentId": "document-id",
                  "kind": "horizontalLine",
                  "horizontalLine": {
                    "kind": "5"
                  }
                },
                "fHfkseAPSHSE": {
                  "id": "fHfkseAPSHSE",
                  "parentId": "document-id",
                  "align": "left",
                  "kind": "text",
                  "text": {
                    "inlineElements": [
                      {
                        "kind": "text",
                        "text": {
                          "text": "你吃完它以后，要是想到了冬天， 那就回忆一下我和你说过的话:“如果你身处长冬，需要火焰驱散寒冷，记得找我。”"
                        }
                      }
                    ],
                    "kind": "body"
                  }
                },
                "h202ouzLER4m": {
                  "id": "h202ouzLER4m",
                  "parentId": "document-id",
                  "kind": "horizontalLine",
                  "horizontalLine": {
                    "kind": "4"
                  }
                },
                "pUJoGJThuVJ0": {
                  "id": "pUJoGJThuVJ0",
                  "parentId": "document-id",
                  "align": "left",
                  "kind": "text",
                  "text": {
                    "inlineElements": [
                      {
                        "kind": "text",
                        "text": {
                          "text": "当然，我并没有忘记今天是什么日子。新年快乐。"
                        }
                      }
                    ],
                    "kind": "body"
                  }
                },
                "uAfZcc7G2Hqx": {
                  "id": "uAfZcc7G2Hqx",
                  "parentId": "document-id",
                  "align": "left",
                  "kind": "text",
                  "text": {
                    "inlineElements": [
                      {
                        "kind": "text",
                        "text": {
                          "text": "我路过食堂时，她们把我叫住，一定要我回答想给这份甜点加什么馅料， 我随手指向了旁边不限量供应冰淇淋的窗口。所以我这份甜点会很冷，也会很甜，但我知道你一定喜欢。"
                        }
                      }
                    ],
                    "kind": "body"
                  }
                }
              },
              "authorMap": {},
              "version": "1.0.0"
            },
