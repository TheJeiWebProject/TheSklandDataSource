        "brief": {
          "cover": "https://bbs.hycdn.cn/image/2025/12/20/203953/e08ee05f27abd8752273653e41170b1a.png",
          "name": "中空异香石",
          "description": {
            "id": "document-id",
            "blockIds": [
              "LXY1iB",
              "9bzHRe",
              "nHekP6"
            ],
            "blockMap": {
              "9bzHRe": {
                "id": "9bzHRe",
                "parentId": "document-id",
                "align": "left",
                "kind": "text",
                "text": {
                  "inlineElements": [
                    {
                      "color": "light_text_tertiary",
                      "kind": "text",
                      "text": {
                        "text": "偶尔能在天使“鞘翅”部位采集到的异香石，味道较之其他异香石有些许不同。绝大部分人难以描述它的味道，“或许是天空的味道”——他们大多会得出这样的结论。"
                      }
                    }
                  ],
                  "kind": "body"
                }
              },
              "LXY1iB": {
                "id": "LXY1iB",
                "parentId": "document-id",
                "align": "left",
                "kind": "text",
                "text": {
                  "inlineElements": [
                    {
                      "bold": true,
                      "color": "light_text_primary",
                      "kind": "text",
                      "text": {
                        "text": "击败仿生翅天使的掉落物，可用于精制食药制作。"
                      }
                    }
                  ],
                  "kind": "body"
                }
              },
