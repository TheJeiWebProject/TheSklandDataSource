                "text": {
                  "inlineElements": [
                    {
                      "bold": true,
                      "kind": "text",
                      "text": {
                        "text": "-结构简单的模块化重型防护装备。"
                      }
                    }
                  ],
                  "kind": "body"
                }
              },
              "xaId4T": {
                "id": "xaId4T",
                "parentId": "document-id",
                "align": "left",
                "kind": "text",
                "text": {
                  "inlineElements": [
                    {
                      "bold": true,
                      "kind": "text",
                      "text": {
                        "text": "如果想要提升防御性能，就无法控制住激增的重量，算是这套装备最严重的痛点。"
                      }
                    }
                  ],
                  "kind": "body"
