                "kind": "text",
                "text": {
                  "inlineElements": [
                    {
                      "bold": true,
                      "kind": "text",
                      "text": {
                        "text": "-本装备由终末地工业自研，使用集成工业系统制造，能够提高使用者的作战能力。"
                      }
                    }
                  ],
                  "kind": "body"
                }
              },
