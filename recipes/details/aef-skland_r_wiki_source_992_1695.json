            "inlineElements": [
              {
                "bold": true,
                "kind": "text",
                "text": {
                  "text": "-本装备由宏山选剑局设计，使用集成工业系统制造，能够提高使用者的作战能力。"
                }
              }
            ],
            "kind": "body"
