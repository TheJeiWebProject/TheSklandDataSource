          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "当管理员在「启程寻访」完成40次寻访并领取全部奖励后，本活动界面将在次日服务器时间04:00关闭。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "NnL7WM": {
          "id": "NnL7WM",
          "parentId": "Tujh1v",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "启程寻访40次后，还可获得【启程武器补给】* 1，开启后可从6星武器"
                }
              },
              {
                "color": "light_rank_orange",
                "kind": "text",
                "text": {
                  "text": "遗忘/破碎君王/热熔切割器/昔日精品/骁勇"
                }
              },
              {
                "kind": "text",
                "text": {
                  "text": "中任意选择一把免费获取。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "UsN05P": {
          "id": "UsN05P",
          "parentId": "9vD3Jk",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "使用【十连启程寻访凭证】可在「启程寻访」中寻访10次，40次寻访内必得6星干员。"
                }
              }
