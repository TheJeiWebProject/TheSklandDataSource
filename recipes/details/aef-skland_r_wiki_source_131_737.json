          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "他始终奋战在抗击天使的最前线，丰富的军事理论知识和团队作战经验让他立下了赫赫战功。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "ohgCSeK0Vyzm": {
          "id": "ohgCSeK0Vyzm",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "骏卫来自罗德岛，以军事顾问的身份为终末地工业提供服务。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "p39H1N2tjRVn": {
          "id": "p39H1N2tjRVn",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“事态紧急，我希望尽快了解你的作战计划……最好就是现在。”"
                }
              }
            ],
            "kind": "body"
          }
        },
        "xcK7IfyJvwyX": {
          "id": "xcK7IfyJvwyX",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "因局势需要，他加入了终末地工业。亦如他曾经所坚信的，他始终认为，管理员会将塔卫二带往一条全新的道路。"
                }
              }
            ],
            "kind": "body"
          }
