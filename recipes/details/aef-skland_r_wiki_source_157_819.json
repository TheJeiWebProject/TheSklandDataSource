      ],
      "blockMap": {
        "ISyJ6m8OqiJc": {
          "id": "ISyJ6m8OqiJc",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“这把铳手感不错！嗯……设计上还有拓展空间，我会把它改成我的专属款！”"
                }
              }
            ],
            "kind": "body"
          }
        },
        "IwU84gseqTOb": {
          "id": "IwU84gseqTOb",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "理由？她从没说过，或许你能问出答案。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "UEerOYBp5XlE": {
          "id": "UEerOYBp5XlE",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "但没有任何人敢否认她是绝对的天才。从学生时代开始，伊冯就在科研领域获得了令人艳羡的成就，然而，当所有人都认为她会入职大型研究所，成为科研的领航人时，伊冯却选择离开那些地方，加入了终末地。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "cM1dsVHKe7Af": {
          "id": "cM1dsVHKe7Af",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“我能给装备改涂装吗？我觉得它的颜色跟我的头发不搭。”"
                }
              }
            ],
            "kind": "body"
          }
        },
        "tl2yyWKMonze": {
          "id": "tl2yyWKMonze",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "伊冯是终末地工业特种技术部门的干员，现负责对超域、侵蚀及相关装置的研究。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "we99bHdb7TwV": {
          "id": "we99bHdb7TwV",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "单从外表来看，伊冯就像是一位叛逆的时尚少女：给自己的角、尾巴和指甲涂上惹眼的色彩；翘掉学术会议去购买时尚杂志和流行唱片……伊冯总会被新奇的事物吸引，以离经叛道的姿态走在潮流最前端。"
                }
              }
            ],
            "kind": "body"
          }
        }
      },
      "authorMap": {},
      "version": "1.0.0"
    },
    "sourcePattern": "text_only"
  },
  "detailLoaded": true
}
