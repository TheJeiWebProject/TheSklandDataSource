                "color": "light_text_primary",
                "kind": "text",
                "text": {
                  "text": "她能够果断且冷静地应对各种危机，但终末地工业所面临的挑战总是超出预期。她来回奔波于文明环带的各处，为终末地的平稳发展竭尽全力。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "hWagBjzkjiU7": {
          "id": "hWagBjzkjiU7",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "color": "light_text_primary",
                "kind": "text",
                "text": {
                  "text": "“我们曾这样不断抵抗……期待着你能再一次归来。”"
                }
              }
            ],
            "kind": "body"
          }
        },
        "i9nZl0m9TJaF": {
          "id": "i9nZl0m9TJaF",
