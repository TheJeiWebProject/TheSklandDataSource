    "wikiDoc": {
      "id": "document-id",
      "blockIds": [
        "TQJ3uMqIjBTD",
        "77d9uxh47XjG",
        "CUkdjXWoCms1",
        "pYhpt7AnKS7V",
        "2wyIc6YQKU4C",
        "rIPHdQkQJ0gX"
      ],
      "blockMap": {
        "2wyIc6YQKU4C": {
          "id": "2wyIc6YQKU4C",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "或许你会觉得弧光有些冷淡，但这份简洁与直接，在荒野之上格外有效。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "77d9uxh47XjG": {
          "id": "77d9uxh47XjG",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "弧光是一位游人，在奥里莎师者的引荐下加入终末地工业，担任外勤干员，及器械车辆技术顾问。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "CUkdjXWoCms1": {
          "id": "CUkdjXWoCms1",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "游荡在荒野上的人们，无论拥有怎样的小聪明，都会被饥馑和灾难追上。弧光是不幸的，荒野吞噬了她的家人，只让她活了下来；她又是幸运的，濒死时，遇到了众生长地的游人。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "TQJ3uMqIjBTD": {
          "id": "TQJ3uMqIjBTD",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“我叫伊库特，代号是弧光，你好。我不会说什么漂亮话，就祝你像涨水的河流一样奔涌吧。”"
                }
              }
            ],
            "kind": "body"
          }
        },
        "pYhpt7AnKS7V": {
          "id": "pYhpt7AnKS7V",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "众生长地接纳了她，她很快学会了如何在自然万物中生存，学会了如何像歌谣中的强者，救助困苦之人。她游走于荒野，让更多生命知晓如何在塔卫二活下去。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "rIPHdQkQJ0gX": {
          "id": "rIPHdQkQJ0gX",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“修摩托车就像给瘤兽看病一样，都需要仔细倾听，然后给出回应。”"
                }
              }
            ],
            "kind": "body"
          }
        }
      },
      "authorMap": {},
      "version": "1.0.0"
    },
    "sourcePattern": "text_only"
  },
  "detailLoaded": true
}
