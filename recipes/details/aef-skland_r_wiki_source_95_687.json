          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "她凭一己之力建立了Z7行动组，短短几个月内完成了招募、训练并投入实战，取得了今日的成绩。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "mBasad": {
          "id": "mBasad",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“Z7行动组，秋栗，很高兴加入这次行动！请期待我的表现！”"
                }
              }
            ],
            "kind": "body"
          }
        },
        "q7L5Kz": {
          "id": "q7L5Kz",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "她的热忱、上进和理想主义感染着身边的人。除此之外，她也会以咖啡和茶点鼓舞大家，不要错过了！"
                }
              }
            ],
            "kind": "body"
          }
        },
        "qr1odW": {
          "id": "qr1odW",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "Z7行动组组长——秋栗，作为年轻的商学院优等生，自荐加入终末地工业。"
                }
              }
            ],
            "kind": "body"
          }
