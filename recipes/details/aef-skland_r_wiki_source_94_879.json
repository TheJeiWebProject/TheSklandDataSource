      "blockMap": {
        "Tzv33oKW6Ob7": {
          "id": "Tzv33oKW6Ob7",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "终末地Z7行动组成员，负责掩护和后勤工作。卡契尔曾接受过完整的军事训练，大量的相关知识储备让他常能在关键时刻为队友们提供合适的建议。他出生于环塔商会一个军人家庭，备受父母与兄姐的关爱。幼年时因意外导致的病痛没有将他击垮，反而促使他逐渐成长为一名坚忍不拔的战士。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "UEImxoOe83Dr": {
          "id": "UEImxoOe83Dr",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“根据大家的建议，最近我又改良了一版野炊浓汤……管理员，有空你可以来尝尝。”"
                }
              }
            ],
            "kind": "body"
          }
        },
        "mXj15RuOCkDe": {
          "id": "mXj15RuOCkDe",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "在小队中，卡契尔年纪最小，但心智的成熟程度却远超队内其他人。他能与每个队友都配合默契，能在队友出状况时主动善后，也能为队友们准备一顿照顾了每个人需求的营地晚餐。很显然，有卡契尔在的地方，总让他的队友们感到安心和自在。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "oEpfg8riXZRZ": {
          "id": "oEpfg8riXZRZ",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“需要掩护吗？我会全力以赴的。”"
                }
              }
            ],
            "kind": "body"
          }
        }
      },
      "authorMap": {},
      "version": "1.0.0"
    },
