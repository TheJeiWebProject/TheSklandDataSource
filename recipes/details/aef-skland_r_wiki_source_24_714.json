      "blockMap": {
        "ErCBwShCO8a4": {
          "id": "ErCBwShCO8a4",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "color": "light_text_primary",
                "kind": "text",
                "text": {
                  "text": "余烬隶属于铁誓军——一个常年驻守北方险要之地的军事组织。为了征募阵亡战友的继任者，余烬回到了文明环带，受邀与终末地工业合作。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "Il5FZ4ve1pfq": {
          "id": "Il5FZ4ve1pfq",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "作为铁誓军陷阵旗队的精锐，余烬的战斗技巧无可挑剔。她总是奋战在最前方，与战友组成坚不可摧的锋线，迎面搅碎敌方的攻势。在敌人面前，她是永不退却的堡垒；在同伴眼中，她是永不垮塌的高墙。要塞和航天母舰构成了铁誓军的筋骨，而像余烬这样的战士，则是铁誓军坚挺的脊梁。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "cHuiEACor9oZ": {
          "id": "cHuiEACor9oZ",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "color": "light_text_primary",
                "kind": "text",
                "text": {
                  "text": "“出发吧，战争没有终点，也没有退路。”"
                }
              }
            ],
            "kind": "body"
          }
        },
        "o9z3OhDn1EBg": {
          "id": "o9z3OhDn1EBg",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“那片极光下方，就是铁誓军的防线。”"
                }
              }
            ],
            "kind": "body"
          }
        }
      },
      "authorMap": {},
      "version": "1.0.0"
    },
    "sourcePattern": "text_only"
  },
