              {
                "bold": true,
                "color": "light_text_primary",
                "kind": "text",
                "text": {
                  "text": "爆炸"
                }
              },
              {
                "color": "light_text_primary",
                "kind": "text",
                "text": {
                  "text": "。爆炸不会伤害我方，会对敌人造成一次较高的伤害。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "5oU4fX": {
          "id": "5oU4fX",
