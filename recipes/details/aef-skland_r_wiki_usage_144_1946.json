          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "当所有奖励领取后，本活动界面将在次日服务器时间04:00关闭。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "jAEnyF": {
