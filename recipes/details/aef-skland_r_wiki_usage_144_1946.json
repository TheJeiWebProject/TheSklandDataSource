          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "权限等阶到达45级，累计可获得"
                }
              },
              {
                "bold": true,
                "kind": "text",
                "text": {
                  "text": "【臻选武器补给】* 1、【星声申领凭证】* 1、【基础寻访凭证】* 40、【嵌晶玉】* 4000"
                }
              },
              {
                "kind": "text",
