            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "【臻选武器补给】开启后，可从6星武器 【"
                }
              },
              {
                "color": "light_rank_orange",
                "kind": "text",
                "text": {
                  "text": "J.E.T.（长柄武器）/白夜新星（单手剑）/爆破单元（施术单元）/楔子（手铳）/典范（双手剑）"
                }
              },
              {
                "kind": "text",
                "text": {
                  "text": "】中任选其一免费获取。"
                }
              }
            ],
            "kind": "body"
          }
