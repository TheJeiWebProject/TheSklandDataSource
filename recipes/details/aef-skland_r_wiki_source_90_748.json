          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "她是极地和高海拔区地理环境的专家，《极地生存指南》的作者，也是无论面对怎样的灾厄都不会轻易放弃任何人的营救者。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "ePhBwFrpsPlR": {
          "id": "ePhBwFrpsPlR",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“风速适中，能见度良好，是滑雪的好天气。”"
                }
              }
            ],
            "kind": "body"
          }
        }
