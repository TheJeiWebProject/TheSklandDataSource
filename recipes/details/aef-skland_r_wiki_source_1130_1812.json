      "blockMap": {
        "QyRxmCNrVMvg": {
          "id": "QyRxmCNrVMvg",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“大当家在此，你、你，还有你，都听我指挥！”"
                }
              }
            ],
            "kind": "body"
          }
        },
        "WoIGWdEZPBkM": {
          "id": "WoIGWdEZPBkM",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "经历过许多挫折的她依旧对世界充满热情。为了寻找问题的答案，也为了更好地发展清波寨，汤汤来到了终末地工业。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "cTFIawqDmnVE": {
          "id": "cTFIawqDmnVE",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "婴儿时期的她顺着河水漂到了清波寨，被寨民收养。虽然年纪尚小，但她已经做好了承担清波寨未来的打算。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "oy3kiN6EwZfl": {
          "id": "oy3kiN6EwZfl",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "别让她跟弭弗碰上，可能会砸坏东西——某位总后勤办事处的干员如是说。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "uIsf79mFZXDK": {
          "id": "uIsf79mFZXDK",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "汤汤，性格直爽，讲究义气的清波寨大当家。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "zINGSpPxI9Bp": {
          "id": "zINGSpPxI9Bp",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“把我叫过来，就是为了夸我呀？那你再夸点儿，我就爱听人说真话！”"
                }
              }
            ],
            "kind": "body"
          }
        }
      },
      "authorMap": {},
      "version": "1.0.0"
    },
    "sourcePattern": "text_only"
  },
  "detailLoaded": true
}
