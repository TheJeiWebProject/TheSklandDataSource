          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "洁尔佩塔来自罗德岛，以信使的身份为终末地工业提供服务。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "Xay8rb7Oe4uN": {
          "id": "Xay8rb7Oe4uN",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "在终末地，她负责多个基地、据点间的书信传递与情报输送工作，常常游走在文明环带与开拓区的交界处。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "Z5mtkz1akVN2": {
          "id": "Z5mtkz1akVN2",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“你好呀！你身上有一股令人怀念的气味……好像一封没有写完的信，我很好奇它会去往哪里。”"
                }
              }
            ],
            "kind": "body"
          }
        }
      },
