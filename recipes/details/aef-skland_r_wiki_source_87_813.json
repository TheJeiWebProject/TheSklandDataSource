      ],
      "blockMap": {
        "B2PWWCdElA7p": {
          "id": "B2PWWCdElA7p",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“抛出去的竿随时可以收回，人一旦陷入漩涡，就无法轻易脱身。”"
                }
              }
            ],
            "kind": "body"
          }
        },
        "IZefTeaW3UmY": {
          "id": "IZefTeaW3UmY",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "他不是很愿意提及自己“无聊”的过去。只知道他曾在开拓区底层摸爬滚打，尝尽争斗与背叛。最终，带着一只失明的眼睛和满身疲惫离开了街头。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "KnTAJKv6BXds": {
          "id": "KnTAJKv6BXds",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "阿列什，由前联盟工团安全局联络人推荐，加入终末地工业，在开拓区担任联络与掩护工作，兼终末地钓鳞兴趣课教师。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "gL6hlN0W01dR": {
          "id": "gL6hlN0W01dR",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "在平时，阿列什的身份是一名贩鳞人，整日沉迷于垂钓。但这无法掩盖他的嗅觉与判断力，真到危急时刻，他的眼神会像钩尖一样锋利，而他应对麻烦的手段和他的钓鳞妙招一样多。任务中，他总是带着松弛的笑意，在最混乱的局面中出奇制胜。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "vx8HNopA7iEP": {
          "id": "vx8HNopA7iEP",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“一定要快快乐乐地活着。管理员，这是我作为过来人的经验。”"
                }
              }
            ],
            "kind": "body"
          }
        }
      },
      "authorMap": {},
      "version": "1.0.0"
    },
    "sourcePattern": "text_only"
  },
  "detailLoaded": true
}
