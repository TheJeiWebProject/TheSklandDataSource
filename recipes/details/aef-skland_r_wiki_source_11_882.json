      "blockMap": {
        "JbI21NIdXe60": {
          "id": "JbI21NIdXe60",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“多利先生？别乱跑哦！和前辈打个招呼吧。”"
                }
              }
            ],
            "kind": "body"
          }
        },
        "N2RSTQR8TUSi": {
          "id": "N2RSTQR8TUSi",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "艾尔黛拉曾专注于火山，但如今投身于超域与地质灾害研究。她常年独自奔走在灾害现场，亲自采集样本，分析结构，总结理论，为终末地制定侵蚀应对措施提供了重要依据。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "UDv7gOJFpDdT": {
          "id": "UDv7gOJFpDdT",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "艾尔黛拉来自罗德岛，以地质研究专家的身份为终末地工业提供服务。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "bZwxqY": {
          "id": "bZwxqY",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“我们必须了解脚下的这颗星球，就像……我们应该更加了解我们自己。对吧，前辈？”"
                }
              }
            ],
            "kind": "body"
          }
        },
        "iSiwxvmYBOky": {
          "id": "iSiwxvmYBOky",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "对了，如果能和艾尔黛拉成为好朋友，那么多利先生也会喜欢你的。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "tvufVuV6pL6C": {
          "id": "tvufVuV6pL6C",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "她始终谦逊、礼貌，内心仿佛有着永不枯竭的力量。只要还能爬更多山，走更多路，聆听属于这个世界的声音，尽情探索这颗星球的秘密，就能让她感到很开心。"
                }
              }
            ],
            "kind": "body"
          }
        }
      },
      "authorMap": {},
      "version": "1.0.0"
    },
    "sourcePattern": "text_only"
  },
  "detailLoaded": true
