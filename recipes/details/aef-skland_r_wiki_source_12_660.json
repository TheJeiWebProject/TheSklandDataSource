            "inlineElements": [
              {
                "color": "light_text_primary",
                "kind": "text",
                "text": {
                  "text": "“看来我不只在武学上有天赋嘛，当你的干员是不是也是一把好手？”"
                }
              }
            ],
            "kind": "body"
          }
        },
