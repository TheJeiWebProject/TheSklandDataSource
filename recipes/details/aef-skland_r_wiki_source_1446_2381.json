          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "color": "light_text_primary",
                "kind": "text",
                "text": {
                  "text": "在阿达希尔的计划受挫后，为了继续打开武陵甚大裂隙的计划，聂菲斯决定对武陵城展开大举进攻；依照管理员和庄方宜等人的谋划，聂菲斯被引入总桩办公室内。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "8uzpoy": {
          "id": "8uzpoy",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "bold": true,
                "kind": "text",
                "text": {
                  "text": "聂菲斯，“碾骨”"
                }
              },
              {
                "kind": "text",
                "text": {
                  "text": "是一类"
                }
              },
              {
                "bold": true,
                "color": "light_rank_orange",
                "kind": "text",
                "text": {
                  "text": "领袖敌人"
                }
              },
              {
                "kind": "text",
                "text": {
                  "text": "。"
                }
              },
              {
                "color": "light_text_primary",
                "kind": "text",
                "text": {
                  "text": "位于武陵城的总桩办公室处，是主线「第二章 - 进程V - "
                }
              },
              {
                "bold": true,
                "color": "light_text_primary",
                "kind": "text",
                "text": {
                  "text": "怒潮 "
                }
              },
              {
                "color": "light_text_primary",
                "kind": "text",
                "text": {
                  "text": "- 决战总桩」的最终Boss。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "F5qYZQtvpJfz": {
          "id": "F5qYZQtvpJfz",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "color": "light_text_primary",
                "kind": "text",
                "text": {
                  "text": "这场漫长的围猎即将结束，管理员一行人终于直面聂菲斯。"
                }
              }
            ],
            "kind": "body"
          }
        }
      },
