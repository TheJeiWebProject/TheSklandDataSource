            "inlineElements": [
              {
                "bold": true,
                "color": "light_text_primary",
                "kind": "text",
                "text": {
                  "text": "-应龙特勤队所配装备的民用版，缺少了关键力量，但具备了普适性。"
                }
              }
            ],
            "kind": "body"
          }
