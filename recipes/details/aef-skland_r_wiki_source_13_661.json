          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "他曾是一名自豪的先进科研工作者，现在也热爱大厨这个光荣职业。"
                }
              }
            ],
            "kind": "body"
          }
        },
