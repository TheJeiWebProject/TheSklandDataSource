            ],
            "kind": "body"
          }
        },
        "mTCXBHq3ThTl": {
          "id": "mTCXBHq3ThTl",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "color": "light_text_primary",
                "kind": "text",
                "text": {
                  "text": "在敌人面前，她是永不退却的堡垒；在同伴眼中，她是永不垮塌的高墙。"
                }
              }
            ],
            "kind": "body"
          }
