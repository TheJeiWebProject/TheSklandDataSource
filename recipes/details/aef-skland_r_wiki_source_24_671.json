                "color": "light_text_primary",
                "kind": "text",
                "text": {
                  "text": "余烬隶属于铁誓军——一个常年驻守北方险要之地的军事组织。为了征募阵亡战友的继任者，余烬回到了文明环带，受邀与终末地工业合作。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "cHuiEACor9oZ": {
          "id": "cHuiEACor9oZ",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "color": "light_text_primary",
                "kind": "text",
                "text": {
                  "text": "“出发吧，战争没有终点，也没有退路。”"
                }
              }
            ],
            "kind": "body"
          }
        },
        "gkaZnITQcGUb": {
          "id": "gkaZnITQcGUb",
