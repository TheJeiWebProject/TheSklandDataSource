      "blockMap": {
        "IvLw5EZBWaIQ": {
          "id": "IvLw5EZBWaIQ",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "终末地Z7行动组成员，负责辅助与源石技术顾问的工作。头脑聪明，思维跳跃，不擅于感知他人情绪，与人沟通时常常会作出和氛围格格不入的发言，让队员们颇为头疼。不过，在源石技艺上，安塔尔其实拥有着极为出众的天赋，虽说对此他并无太多自觉。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "LtbpsjP1vGsk": {
          "id": "LtbpsjP1vGsk",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“轮到我出任务了么？正好，我也想找机会测试浮游炮的改造成效。”"
                }
              }
            ],
            "kind": "body"
          }
        },
        "VPjloYUpaWn9": {
          "id": "VPjloYUpaWn9",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "受祖母的影响，安塔尔对世俗的成功毫不在意，他几乎将所有注意力都投注在了自己感兴趣的事物上。比如一件他没见过的源石装置，又比如一个让他啧啧称奇的冷笑话，都能让这位年轻的萨弗拉废寝忘食地研究数个日夜，直到他觉得自己弄明白了为止。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "r120DBcG5Arv": {
          "id": "r120DBcG5Arv",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "“很奇怪，一见到您，我的分享欲就格外强烈。”"
                }
              }
            ],
            "kind": "body"
          }
        }
      },
      "authorMap": {},
      "version": "1.0.0"
    },
    "sourcePattern": "text_only"
  },
  "detailLoaded": true
}
