          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "bold": true,
                "kind": "text",
                "text": {
                  "text": "装备"
                }
              },
              {
                "kind": "text",
                "text": {
                  "text": "：集成工业系统是干员装备的唯一产出方式。"
                }
              }
            ],
            "kind": "body"
          }
        },
