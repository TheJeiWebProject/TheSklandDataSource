          "text": {
            "inlineElements": [
              {
                "bold": true,
                "kind": "text",
                "text": {
                  "text": "三位一体"
                }
              },
              {
                "kind": "text",
                "text": {
                  "text": "（Triaggelos）是《明日方舟：终末地》中的一类"
                }
              },
              {
                "bold": true,
                "color": "light_rank_orange",
                "kind": "text",
                "text": {
                  "text": "领袖敌人"
                }
              },
              {
                "kind": "text",
                "text": {
                  "text": "。位于"
                }
              },
              {
                "color": "light_text_primary",
                "kind": "text",
                "text": {
                  "text": "矿脉源区的世代摇篮处，是"
                }
              },
              {
                "kind": "text",
                "text": {
                  "text": "主线「第一章 - 进程III - 登途之路 - 世代摇篮」的最终Boss。"
                }
              }
            ],
            "kind": "body"
          }
        },
        "Mc7HD3": {
          "id": "Mc7HD3",
          "parentId": "document-id",
          "align": "left",
          "kind": "text",
          "text": {
            "inlineElements": [
              {
                "kind": "text",
                "text": {
                  "text": "三位一体本是约二十年前袭击四号谷地的巨大天使，代号”星体“的三根残肢。四号谷地袭击事件中，在聂菲斯的计划下，锚点激活了残存在世代摇篮的”星体“残肢，并重新组合成了代号为”三位一体“的天使。后被管理员再次击败。"
                }
              }
            ],
            "kind": "body"
          }
        }
      },
